<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:loc="clr-namespace:FoodStreetMobile.Localization"
             x:Class="FoodStreetMobile.MainPage"
             BackgroundColor="#FDF8F5"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*" RowSpacing="0">
        <Grid>
            <maps:Map x:Name="PoiMap"
                      IsShowingUser="False" />
            <ImageButton x:Name="LocateMeButton"
                         Source="ic_my_location.svg"
                         WidthRequest="46"
                         HeightRequest="46"
                         Padding="11"
                         Margin="0,0,16,140"
                         VerticalOptions="End"
                         HorizontalOptions="End"
                         BackgroundColor="White"
                         BorderColor="#D1D5DB"
                         BorderWidth="1"
                         CornerRadius="23"
                         Clicked="OnLocateMeClicked">
                <ImageButton.Shadow>
                    <Shadow Opacity="0.18"  
                            Radius="10"
                            Offset="0,3" />
                </ImageButton.Shadow>
            </ImageButton>
            <Border Margin="0,0,16,196"
                    Padding="0"
                    VerticalOptions="End"
                    HorizontalOptions="End"
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Opacity="0.14"
                            Radius="10"
                            Offset="0,3" />
                </Border.Shadow>
                <Button Text="{loc:Translate Key=Main_ExploreVinhKhanh}"
                        FontSize="12"
                        FontAttributes="Bold"
                        Padding="12,6"
                        BackgroundColor="#FFFFFF"
                        TextColor="#9A3412"
                        CornerRadius="20"
                        Clicked="OnGoToVinhKhanhClicked" />
            </Border>
            <Border Margin="16,20"
                    Padding="6"
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 22"
                    VerticalOptions="Start"
                    HorizontalOptions="Fill">
                <Border.Shadow>
                    <Shadow Opacity="0.1"
                            Radius="15"
                            Offset="0,6" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                         <Entry x:Name="PlaceSearchEntry"
                               Placeholder="{loc:Translate Key=Main_SearchPlaceholder}"
                               BackgroundColor="Transparent"
                               Keyboard="Text"
                               Margin="12,6"
                               ReturnType="Search"
                               Completed="OnPlaceSearchCompleted" />
                        <ImageButton Grid.Column="1"
                                     Source="ic_search.svg"
                                     WidthRequest="40"
                                     HeightRequest="40"
                                     Padding="8"
                                     BackgroundColor="#EDEDED"
                                     CornerRadius="20"
                                     Clicked="OnSearchPlaceClicked" />
                    </Grid>
                    <HorizontalStackLayout Grid.Row="1"
                                           x:Name="SearchStatusLayout"
                                           Margin="10,0,10,2"
                                           Spacing="8"
                                           IsVisible="False">
                        <ActivityIndicator x:Name="SearchLoadingIndicator"
                                           IsRunning="False"
                                           Color="#C2410C"
                                           WidthRequest="14"
                                           HeightRequest="14" />
                        <Label x:Name="SearchErrorLabel"
                               Text=""
                               FontSize="11"
                               TextColor="#B91C1C"
                               VerticalOptions="Center"
                               IsVisible="False" />
                    </HorizontalStackLayout>
                    <CollectionView x:Name="SearchResultsView"
                                    Grid.Row="2"
                                    Margin="6,4,6,6"
                                    IsVisible="False"
                                    HeightRequest="190"
                                    SelectionMode="Single"
                                    SelectionChanged="OnSearchResultSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Stroke="#EFE7DF"
                                        StrokeShape="RoundRectangle 12"
                                        Margin="0,3"
                                        BackgroundColor="White">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               TextColor="#2F1A0F"
                                               FontAttributes="Bold"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding DistanceText}"
                                               FontSize="12"
                                               TextColor="#8A6A58"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
            <Border x:Name="StatusBanner"
                    Margin="16,88,16,0"
                    Padding="10,7"
                    BackgroundColor="#FFF7ED"
                    Stroke="#FED7AA"
                    StrokeShape="RoundRectangle 14"
                    IsVisible="False"
                    VerticalOptions="Start"
                    HorizontalOptions="Fill">
                <Label Text="{Binding StatusText}"
                       FontSize="12"
                       TextColor="#7C2D12"
                       LineBreakMode="WordWrap" />
            </Border>
            <Border x:Name="SearchBottomSheet"
                    VerticalOptions="End"
                    Stroke="#F2E8E0"
                    BackgroundColor="#FFFBF7"
                    Padding="16,10,16,18"
                    StrokeShape="RoundRectangle 20,20,0,0"
                    TranslationY="1000">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid>
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnBottomSheetPanUpdated" />
                        </Grid.GestureRecognizers>
                        <BoxView WidthRequest="52"
                                 HeightRequest="5"
                                 Color="#DCCFC4"
                                 CornerRadius="3"
                                 HorizontalOptions="Center" />
                    </Grid>
                    <ScrollView Grid.Row="1"
                                VerticalScrollBarVisibility="Always">
                        <VerticalStackLayout Spacing="10">
                            <Image x:Name="SheetImage"
                                   HeightRequest="138"
                                   Aspect="AspectFill"
                                   Source="dotnet_bot.png" />
                             <Label x:Name="SheetTitleLabel"
                                   Text="{loc:Translate Key=Main_SheetNoPlaceSelected}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#5A2A0C" />
                              <Label x:Name="SheetAddressLabel"
                                     Text="{loc:Translate Key=Main_SheetHintSelectPlace}"
                                     FontSize="13"
                                     TextColor="#8B5E42" />
                            <Border x:Name="AudioPlayerContainer"
                                    IsVisible="False"
                                    Padding="10"
                                    BackgroundColor="#FFF7ED"
                                    Stroke="#FED7AA"
                                    StrokeShape="RoundRectangle 12">
                                <WebView x:Name="AudioPlayerWebView"
                                         Navigating="OnAudioPlayerWebViewNavigating"
                                         HeightRequest="190" />
                            </Border>
                            <Border x:Name="TtsPlayerContainer"
                                    IsVisible="False"
                                    Padding="10"
                                    BackgroundColor="#FFF7ED"
                                    Stroke="#FED7AA"
                                    StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8">
                                        <Label x:Name="TtsCurrentTimeLabel"
                                               Text="00:00"
                                               VerticalOptions="Center"
                                               FontSize="11"
                                               TextColor="#7C2D12" />
                                        <Slider x:Name="TtsProgressSlider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="0"
                                                DragStarted="OnTtsProgressDragStarted"
                                                DragCompleted="OnTtsProgressDragCompleted"
                                                ValueChanged="OnTtsProgressValueChanged" />
                                        <Label x:Name="TtsDurationLabel"
                                               Grid.Column="2"
                                               Text="00:00"
                                               VerticalOptions="Center"
                                               FontSize="11"
                                               TextColor="#7C2D12" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Button Text="⏮ 10s"
                                                FontSize="12"
                                                BackgroundColor="#FDE7D7"
                                                TextColor="#7C2D12"
                                                CornerRadius="12"
                                                Clicked="OnTtsSkipBackwardClicked" />
                                        <Button Grid.Column="1"
                                                x:Name="TtsPlayPauseButton"
                                                Text="▶️"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                BackgroundColor="#E07A5F"
                                                TextColor="White"
                                                CornerRadius="12"
                                                Clicked="OnTtsPlayPauseClicked" />
                                        <Button Grid.Column="2"
                                                Text="10s ⏭"
                                                FontSize="12"
                                                BackgroundColor="#FDE7D7"
                                                TextColor="#7C2D12"
                                                CornerRadius="12"
                                                Clicked="OnTtsSkipForwardClicked" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Text="{loc:Translate Key=Main_Volume}"
                                               FontSize="12"
                                               TextColor="#7C2D12"
                                               VerticalOptions="Center" />
                                        <Slider x:Name="TtsVolumeSlider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="0.8" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <Button Text="{loc:Translate Key=Main_Directions}"
                                        BackgroundColor="#E07A5F"
                                        TextColor="White"
                                        CornerRadius="14"
                                        Clicked="OnDirectionsClicked" />
                                <Button Grid.Column="1"
                                        x:Name="PlayAudioButton"
                                        Text="{loc:Translate Key=Main_PlayAudio}"
                                        BackgroundColor="#F4E7DC"
                                        TextColor="#5A2A0C"
                                        CornerRadius="14"
                                        IsEnabled="False"
                                        Clicked="OnPlayAudioClicked" />
                                <Button Grid.Column="2"
                                        Text="{loc:Translate Key=Main_Save}"
                                        BackgroundColor="#F4E7DC"
                                        TextColor="#5A2A0C"
                                        CornerRadius="14"
                                        Clicked="OnSaveClicked" />
                                <Button Grid.Column="3"
                                        Text="{loc:Translate Key=Main_Share}"
                                        BackgroundColor="#F4E7DC"
                                        TextColor="#5A2A0C"
                                        CornerRadius="14"
                                        Clicked="OnShareClicked" />
                            </Grid>
                            <Border x:Name="PlaybackQueuePanel"
                                    Padding="12,10"
                                    BackgroundColor="#FFF7ED"
                                    Stroke="#FED7AA"
                                    StrokeShape="RoundRectangle 14"
                                    IsVisible="False">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{loc:Translate Key=Main_NowPlaying}"
                                           FontSize="11"
                                           TextColor="#9A3412" />
                                    <Label x:Name="CurrentPlayingNameLabel"
                                           Text="--"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#7C2D12"
                                           LineBreakMode="TailTruncation" />
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8">
                                        <Label x:Name="CurrentPlayingTimeLabel"
                                               Text="00:00"
                                               VerticalOptions="Center"
                                               FontSize="11"
                                               TextColor="#7C2D12" />
                                        <ProgressBar x:Name="CurrentPlayingProgressBar"
                                                     Grid.Column="1"
                                                     Progress="0"
                                                     HeightRequest="6"
                                                     VerticalOptions="Center"
                                                     ProgressColor="#E07A5F"
                                                     BackgroundColor="#FDE7D7" />
                                        <Label x:Name="CurrentPlayingDurationLabel"
                                               Grid.Column="2"
                                               Text="00:00"
                                               VerticalOptions="Center"
                                               FontSize="11"
                                               TextColor="#7C2D12" />
                                    </Grid>
                                    <Border x:Name="QueueInfoBorder"
                                            IsVisible="False"
                                            Padding="8,6"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#FDE7D7"
                                            StrokeShape="RoundRectangle 10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Translate Key=Main_PlaybackQueue}"
                                                   FontSize="11"
                                                   TextColor="#9A3412" />
                                            <Label x:Name="QueuedPoiNameLabel"
                                                   Text="--"
                                                   FontSize="13"
                                                   TextColor="#7C2D12"
                                                   LineBreakMode="TailTruncation" />
                                            <Label x:Name="QueuedPoiDistanceLabel"
                                                   Text=""
                                                   FontSize="11"
                                                   TextColor="#9A3412"
                                                   IsVisible="False" />
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>




<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:FoodStreetMobile.Localization"
             x:Class="FoodStreetMobile.RegisterPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFF4EE">

    <ScrollView>
        <VerticalStackLayout Padding="24,60,24,24" Spacing="24">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="🍔" FontSize="64" HorizontalOptions="Center" />
                <Label Text="{loc:Translate Key=Auth_RegisterPageTitle}"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#EA580C"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Padding="12,10"
                    BackgroundColor="#FEF3E7"
                    Stroke="#FFEDD5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    HorizontalOptions="Fill">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="🌐"
                           FontSize="20"
                           VerticalOptions="Start"
                           Margin="0,2,0,0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="{loc:Translate Key=Profile_LanguageLabel}"
                               FontSize="12"
                               TextColor="#78716C" />
                        <Picker ItemsSource="{Binding Languages}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedLanguage}"
                                FontSize="13"
                                TextColor="#1C1917"
                                HeightRequest="42" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="24"
                    BackgroundColor="White"
                    Stroke="#FFEDD5"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 24"
                    Margin="0,16,0,0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="16">
                    <Label Text="{loc:Translate Key=Auth_RegisterSection}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1C1917"
                           Margin="0,0,0,4" />
                    
                    <Entry Text="{Binding RegUsername}"
                           Placeholder="{loc:Translate Key=Auth_RegUsername}"
                           TextColor="#1C1917"
                           PlaceholderColor="#A8A29E"
                           HeightRequest="50"
                           ClearButtonVisibility="WhileEditing" />
                           
                    <Entry Text="{Binding RegFullName}"
                           Placeholder="{loc:Translate Key=Auth_RegFullName}"
                           TextColor="#1C1917"
                           PlaceholderColor="#A8A29E"
                           HeightRequest="50"
                           ClearButtonVisibility="WhileEditing" />
                           
                    <Entry Text="{Binding RegPhone}"
                           Placeholder="{loc:Translate Key=Auth_RegPhone}"
                           Keyboard="Telephone"
                           TextColor="#1C1917"
                           PlaceholderColor="#A8A29E"
                           HeightRequest="50"
                           ClearButtonVisibility="WhileEditing" />
                           
                    <Entry Text="{Binding RegPassword}"
                           Placeholder="{loc:Translate Key=Auth_Password}"
                           IsPassword="True"
                           TextColor="#1C1917"
                           PlaceholderColor="#A8A29E"
                           HeightRequest="50"
                           ClearButtonVisibility="WhileEditing" />

                    <Button Text="{loc:Translate Key=Auth_Register}"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="#EA580C"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="14"
                            HeightRequest="54"
                            Margin="0,16,0,0" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="6"
                                   Margin="0,16,0,0">
                <Label Text="{loc:Translate Key=Auth_AlreadyHaveAccount}"
                       FontSize="15"
                       TextColor="#78716C"
                       VerticalTextAlignment="Center" />
                <Label FontSize="15"
                       TextColor="#EA580C"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       Text="{loc:Translate Key=Auth_LinkLogin}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

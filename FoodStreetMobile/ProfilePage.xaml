<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:FoodStreetMobile.Localization"
             x:Class="FoodStreetMobile.ProfilePage"
             BackgroundColor="#FFF4EE"
             Title="{loc:Translate Key=Profile_Title}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="20">
            <VerticalStackLayout Spacing="8" Margin="0,0,0,8">
                <Label Text="👤" FontSize="48" HorizontalOptions="Center" />
                <Label Text="{loc:Translate Key=Profile_AccountHeader}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#EA580C"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>



            <Border Padding="20"
                    BackgroundColor="White"
                    Stroke="#FFEDD5"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate Key=Profile_LanguageLabel}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1C1917" />

                    <Border Stroke="#E7E5E4" StrokeShape="RoundRectangle 12" BackgroundColor="#F5F5F4" Padding="12,0">
                        <Picker ItemsSource="{Binding Languages}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedLanguage}"
                                TextColor="#1C1917"
                                TitleColor="#A8A29E"
                                BackgroundColor="Transparent"
                                HeightRequest="50" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Padding="20"
                    BackgroundColor="White"
                    Stroke="#FFEDD5"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
                </Border.Shadow>

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="{loc:Translate Key=Profile_PoiHistory}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1C1917"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="›"
                           FontSize="28"
                           TextColor="#A8A29E"
                           VerticalTextAlignment="Center" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPoiHistoryCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
